// async.vsx — .vsx v2 generics, switch expressions, spreads, and bare element props
package main

enum LoadState<T> {
    case loading
    case ready(T)
    case failed(string)
}

func Profile(state: LoadState<string>, onRetry: () -> void) -> Element {
    return (
        <section>
            {switch state {
            case .loading:       <Spinner />
            case .ready(let u):  <UserCard user={u} />
            case .failed(let e): <ErrorNote error={e} retry={{ onRetry() }} />
            }}
        </section>
    )
}

func List<T>(items: [T], renderItem: (T) -> Element) -> Element {
    return <ul>{items.map { item in renderItem(item) }}</ul>
}

func Parts(attrs: [string: string], w: int) -> Element {
    return (
        <>
            <div {...attrs} style={Style(width: "\(w)px", color: "red")} data-p="main" />
            {/* a comment */}
            <Card header=<h2>Hi</h2> badge=<i>new</i>>body</Card>
            <List<string> items={["a", "b"]} renderItem={s in <li>{s}</li>} />
        </>
    )
}

func Generic() -> bool {
    let xs = [3, 1, 2].sorted(by: <)
    return xs.count < 4 && Array<int>().isEmpty
}
