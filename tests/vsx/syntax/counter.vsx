// counter.vsx — .vsx v2 function component with useState hook
package main

func Counter(initialCount: int = 0, label: string = "Count") -> Element {
    let (count, setCount) = useState(initialCount)

    return (
        <div className="counter-card">
            <h3>{label}: {count}</h3>
            <button onClick={{ setCount(count + 1) }}>Increment</button>
            <button onClick={{ setCount(0) }} disabled={count == 0}>Reset</button>
        </div>
    )
}

func main() -> int32 {
    let view = <Counter initialCount={5} label="Clicks" />
    print(renderToString(view))
    return 0
}
