// tasks.vsx — .vsx v2 tasks application with hooks, map + key, and conditional rendering
package main

struct Todo: Equatable {
    let id: int
    var title: string
    var done: bool
}

enum Filter: CaseIterable { case all, active, done }

func TodoItem(todo: Todo, onToggle: (int) -> void) -> Element {
    return (
        <li className={todo.done ? "item done" : "item"}>
            <input type="checkbox" checked={todo.done} onChange={{ onToggle(todo.id) }} />
            <span>{todo.title}</span>
        </li>
    )
}

func App(initialTodos: [Todo] = []) -> Element {
    let (todos, setTodos) = useState(initialTodos)
    let (filter, setFilter) = useState(Filter.all)
    let (draft, setDraft) = useState("")

    let visible: [Todo] = {
        switch filter {
        case .all:    return todos
        case .active: return todos.filter { !$0.done }
        case .done:   return todos.filter { $0.done }
        }
    }()

    return (
        <main className="app">
            <form onSubmit={e in
                e.preventDefault()
                if !draft.isEmpty {
                    let nextId = todos.count + 1
                    setTodos(todos + [Todo(id: nextId, title: draft, done: false)])
                    setDraft("")
                }
            }>
                <input
                    placeholder="What needs doing?"
                    value={draft}
                    onChange={e in setDraft(e.target.value)}
                    autoFocus
                />
            </form>

            <nav>
                {Filter.allCases.map { f in
                    <button
                        key={"\(f)"}
                        className={filter == f ? "on" : ""}
                        onClick={{ setFilter(f) }}
                    >
                        {f}
                    </button>
                }}
            </nav>

            {if visible.isEmpty {
                <p className="empty">Nothing here.</p>
            } else {
                <ul>
                    {visible.map { t in
                        <TodoItem
                            key={t.id}
                            todo={t}
                            onToggle={id in
                                setTodos(todos.map { item in
                                    item.id == id ? Todo(id: item.id, title: item.title, done: !item.done) : item
                                })
                            }
                        />
                    }}
                </ul>
            }}
        </main>
    )
}
