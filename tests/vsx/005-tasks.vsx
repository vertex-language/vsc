// Tasks app in .vsx v2: add, toggle and filter, driven by events and
// rendered with standard .map and key={t.ID}.
package main

struct Todo {
    let ID: int
    var Title: string
    var Done: bool
}

enum Filter { case all, active, done }

final class Store {
    var Todos: [Todo] = []
    var Filter: Filter = .all
    var nextID = 1

    var Visible: [Todo] {
        switch Filter {
        case .all:    return Todos
        case .active: return Todos.filter { !$0.Done }
        case .done:   return Todos.filter { $0.Done }
        }
    }

    func Add(title: string) {
        Todos.append(Todo(ID: nextID, Title: title, Done: false))
        nextID += 1
    }

    func Toggle(id: int) {
        for i in 0..<Todos.count where Todos[i].ID == id { Todos[i].Done = !Todos[i].Done }
    }
}

func TodoItem(todo: Todo, onToggle: (int) -> void) -> Element {
    return (
        <li className={todo.Done ? "item done" : "item"}>
            <input type="checkbox" checked={todo.Done} onChange={onToggle(todo.ID)} />
            <span>{todo.Title}</span>
        </li>
    )
}

func App(store: Store, draft: string) -> Element {
    return (
        <main className="app">
            <form onSubmit={e in
                e.PreventDefault()
                if !draft.isEmpty { store.Add(draft) }
            }>
                <input placeholder="What needs doing?" value={draft} autoFocus />
            </form>
            {if store.Visible.isEmpty {
                <p className="empty">Nothing here.</p>
            } else {
                <ul>
                    {store.Visible.map { t in
                        <TodoItem key={t.ID} todo={t} onToggle={store.Toggle} />
                    }}
                </ul>
            }}
        </main>
    )
}

func main() -> int32 {
    let store = Store()
    print(App(store: store, draft: "").Html())
    _ = App(store: store, draft: "buy milk").Fire("submit")
    _ = App(store: store, draft: "walk").Fire("submit")
    print(App(store: store, draft: "").Html())
    _ = App(store: store, draft: "").Fire("change")
    store.Filter = .done
    print(App(store: store, draft: "").Html())
    return 0
}
// want: <main class="app"><form><input placeholder="What needs doing?" value="" autofocus></form><p class="empty">Nothing here.</p></main>
// want: <main class="app"><form><input placeholder="What needs doing?" value="" autofocus></form><ul><li class="item"><input type="checkbox"><span>buy milk</span></li><li class="item"><input type="checkbox"><span>walk</span></li></ul></main>
// want: <main class="app"><form><input placeholder="What needs doing?" value="" autofocus></form><ul><li class="item done"><input type="checkbox" checked><span>buy milk</span></li></ul></main>
