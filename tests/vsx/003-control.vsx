// `if`, `switch`, ternary, and `&&` in braces are expressions whose branches
// are markup; Style(...) and spreads apply to intrinsic elements.
package main

enum Load { case loading, ready(string), failed(int) }

func Status(s: Load) -> Element {
    return (
        <p>
            {switch s {
            case .loading:       <i>…</i>
            case .ready(let v):  <b>{v}</b>
            case .failed(let c): <em>error {c}</em>
            }}
        </p>
    )
}

func main() -> int32 {
    for s in [Load.loading, .ready("ok"), .failed(404)] {
        print(Status(s).Html())
    }
    let empty = [string]()
    let done = true
    let extra = ["data-a": "1", "aria-label": "x"]
    let v = (
        <div
            className={done ? "row done" : "row off"}
            style={Style(width: "\(40)px", color: "red")}
            {...extra}
        >
            {if empty.isEmpty {
                <p className="empty">Nothing here.</p>
            } else {
                <ul>{empty.map { <li>{$0}</li> }}</ul>
            }}
            {done ? "yes" : nil}
        </div>
    )
    print(v.Html())
    return 0
}
// want: <p><i>…</i></p>
// want: <p><b>ok</b></p>
// want: <p><em>error 404</em></p>
// want: <div aria-label="x" data-a="1" class="row done" style="color: red; width: 40px"><p class="empty">Nothing here.</p>yes</div>
