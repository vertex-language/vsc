// Components are functions: attributes are labeled arguments, children
// are passed as a Node or function child, and a dotted name is a
// namespaced function.
package main

func Card(title: string, wide: bool = false, children: Node = nil) -> Element {
    return (
        <section className={wide ? "card wide" : "card"}>
            <h2>{title}</h2>
            {children}
        </section>
    )
}

func List<T>(each: [T], children: (T) -> Element) -> Element {
    return <ul>{each.map { children($0) }}</ul>
}

func Badge(label: string) -> Element { return <b>{label}</b> }

enum kit {
    static func Button(label: string, onPress: () -> void) -> Element {
        return <button onClick={onPress()}>{label}</button>
    }
}

func main() -> int32 {
    var pressed = 0
    let names = ["ann", "bo"]
    let page = (
        <>
            <Card title="Team" wide>
                <p>Members:</p>
                <List<string> each={names}>
                    {n in <li><Badge label={n} /></li>}
                </List>
            </Card>
            <kit.Button label="Go" onPress={pressed += 1} />
        </>
    )
    print(page.Html())
    _ = page.Fire("click")
    _ = page.Fire("click")
    print(pressed)
    return 0
}
