// Handlers and useState hook: `{…}` in a function-typed attribute is the
// closure, taking the event it may ignore; `{e in …}` names it; a reference
// is passed as it is; state a handler writes with useState re-renders the
// component's fiber.
package main

final class Store {
    var Todos: [string] = []
    var Last = ""
    func Add(_ t: string) { Todos.append(t) }
    func Clear(_ e: MouseEvent) { Todos = [] }
}

func Form(store: Store) -> Element {
    let (draft, setDraft) = useState("milk")
    let (submits, setSubmits) = useState(0)
    return (
        <form onSubmit={e in
            e.preventDefault()
            setSubmits(submits + 1)
            if !draft.isEmpty {
                store.Add(draft)
                setDraft("")
            }
            store.Last = e.type + (e.defaultPrevented ? " (prevented)" : "")
        }>
            <input value={draft} onInput={_ in setDraft("eggs")} />
            <button type="reset" onClick={store.Clear}>clear ({submits})</button>
        </form>
    )
}

func main() -> int32 {
    let store = Store()
    let form = <Form store={store} />
    _ = form.Fire("submit")
    _ = form.Fire("input")
    _ = form.Fire("submit")
    _ = form.Fire("submit")
    print(store.Todos, store.Last)
    _ = form.Fire("click")
    print(store.Todos)
    return 0
}
